# StreamFlix Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/mediahub

# ─── Redis (Optional Caching) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Authentication Secret ───────────────────────────────────
JWT_SECRET=streamflix-secret-key-change-in-production

# ─── TMDB (The Movie Database) API Integration ──────────────────
# Get your free v3 API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ─── Python ML Recommender Service URL ──────────────────────────
RECOMMENDER_URL=http://localhost:8000

# ─── Frontend API URL ───────────────────────────────────────────
VITE_API_URL=http://localhost:5001

# ─── Postgres (for docker-compose) ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mediahub
